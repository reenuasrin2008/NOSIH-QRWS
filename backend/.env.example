# QUANTUM RESCUE — ENVIRONMENT CONFIGURATION
# Copy to .env and configure your keys. Never expose API keys to frontend bundles.

# GROK (xAI) — Up to 3 keys supported by the 6-key pool
GROK_API_KEY_1=
GROK_API_KEY_2=
GROK_API_KEY_3=
GROK_MODEL=grok-3

# GEMINI (Google) — Up to 3 keys supported by the 6-key pool
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash

# AI ORCHESTRATOR CONTROL
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=grok
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_SECONDS=60
AI_STREAMING_ENABLED=true
AI_TOOL_CALLING_ENABLED=true
AI_LOG_PROMPTS=false

# LOCAL FILE STORAGE (Zero external databases required — generated and stored locally)
LOCAL_DATA_DIR=./local_data
BACKEND_SECRET=change-this-secret-before-shared-deployment
QR_DEMO_ADMIN_PASSWORD=quantum-admin-local
